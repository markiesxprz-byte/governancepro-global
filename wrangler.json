{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"governancepro-global",
  "main":"src/index.js",
  "compatibility_date":"2026-10-02",
  "assets":{
    "directory":"./public",
    "binding":"ASSETS",
    "run_worker_first":["/api/*"]
  },
  "d1_databases":[
    {
      "binding":"DB",
      "database_name":"governancepro",
      "database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}